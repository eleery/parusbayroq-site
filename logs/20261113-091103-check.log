== public_html/.htaccess
# ===== Каноническая версия сайта: https://parusbayroq.uz/ =====
RewriteEngine On

# 1) Принудительный HTTPS (http -> https)
#    Покрывает http://parusbayroq.uz/ и http://www.parusbayroq.uz/
RewriteCond %{HTTPS} off
RewriteRule ^ https://parusbayroq.uz%{REQUEST_URI} [L,R=301]

# 2) Убираем www (www -> без www)
#    Покрывает https://www.parusbayroq.uz/
RewriteCond %{HTTP_HOST} ^www\.parusbayroq\.uz$ [NC]
RewriteRule ^ https://parusbayroq.uz%{REQUEST_URI} [L,R=301]

# 3) Главная без слеша -> со слешем (https://parusbayroq.uz -> https://parusbayroq.uz/)
#    На корне обычно не требуется (сервер сам отдаёт /), правило оставлено как страховка.
RewriteCond %{HTTP_HOST} ^parusbayroq\.uz$ [NC]
RewriteCond %{REQUEST_URI} ^$
RewriteRule ^ https://parusbayroq.uz/ [L,R=301]
