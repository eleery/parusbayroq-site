---
// /blog/ exists only when there is at least one article to show.
import BlogIndex from '../../components/BlogIndex.astro';
import { getPosts } from '../../lib/blog.mjs';
export async function getStaticPaths() {
  return (await getPosts('ru')).length ? [{ params: { index: undefined } }] : [];
}
---
<BlogIndex lang="ru" />
